# =====================================================================================================================
# LOCAL development only. Copy to `.env` (never commit it). Production values go in Vercel -> Project Settings -> Environment
# Variables (see docs/DEPLOYMENT.md for the exact list). Local and production databases must be DIFFERENT.
# =====================================================================================================================

# ---- App ----
APP_ENV=development              # development | test | production  (Vercel production is detected automatically)
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Database ----
# Local: SQLite file (fine for development).
DATABASE_URL=sqlite:///./data/portfolio.db
# Production: the POOLED connection string from your managed PostgreSQL (e.g. Neon "Pooled connection"). postgres:// and
# postgresql:// URLs are accepted and converted automatically. TLS (sslmode=require) is enforced for remote hosts.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# ---- Security ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"   (>= 32 chars is enforced in production)
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
# Admin and site share one origin, so CORS is not needed. Only set this if another website must call the PUBLIC api from a browser.
PUBLIC_ORIGINS=http://localhost:8000
# Public URL of the site (canonical/sitemap). Leave empty on Vercel: it is derived from the production domain automatically.
SITE_URL=
# auto = memory locally, database in production/Vercel (serverless instances don't share memory). Options: auto | memory | db
RATE_LIMIT_BACKEND=auto
# auto = trust X-Forwarded-For only on Vercel. Options: auto | true | false  (never "true" unless a proxy you control sets the header)
TRUST_PROXY_HEADERS=auto

# ---- Gemini chatbot (key stays on the server) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash    # check Google AI Studio for currently available models
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
CHAT_RATE_PER_MINUTE=12
CHAT_MAX_MESSAGE_CHARS=800

# ---- Email for contact notifications (Resend recommended) ----
EMAIL_PROVIDER=disabled          # disabled | resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=Portfolio <onboarding@resend.dev>
NOTIFY_EMAIL=
CONTACT_RATE_PER_HOUR=5
# auto = send before replying on Vercel (functions can be frozen after the response), in the background elsewhere. Options: auto | inline | background
EMAIL_SEND_MODE=auto
GOOGLE_SITE_VERIFICATION=